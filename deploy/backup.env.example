# Copie para deploy/backup.env e proteja com chmod 600.
# A chave deve existir também fora da VPS; sem ela o backup é irrecuperável.
BACKUP_KEY_FILE=/opt/menuzap/deploy/backup.key
BACKUP_DIRECTORY=/opt/menuzap/backups
BACKUP_REMOTE_HOST=backup@backup.example.com
BACKUP_REMOTE_DIRECTORY=/srv/backups/menuzap
